<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{5B1D7A93-6E24-4C0F-8A71-9D3E2F6B0C48}</ProjectGuid>
    <TargetFramework>net48</TargetFramework>
    <AssemblyTitle>OverlayPluginAddon</AssemblyTitle>
    <Product>OverlayPluginAddon</Product>
    <Copyright>Copyright © 2026 OverlayPluginAddon</Copyright>
    <OutputPath>..\..\out\$(Configuration)\OverlayPluginAddon\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Advanced Combat Tracker">
      <HintPath>..\..\OverlayPlugin\Thirdparty\ACT\Advanced Combat Tracker.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FFXIV_ACT_Plugin.Common">
      <HintPath>..\..\OverlayPlugin\Thirdparty\FFXIV_ACT_Plugin\SDK\FFXIV_ACT_Plugin.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OverlayPlugin\OverlayPlugin.Common\OverlayPlugin.Common.csproj" Private="False" />
    <ProjectReference Include="..\..\OverlayPlugin\OverlayPlugin.Core\OverlayPlugin.Core.csproj" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <!-- 13.0.3 rather than OverlayPlugin's 13.0.1 because ClearScript needs at least that. Every
         13.x carries assembly version 13.0.0.0, so the two load as one assembly either way. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- FFLogs' log parser is JavaScript and stays JavaScript: it is proprietary, obfuscated and
         reissued on their schedule, so it is hosted rather than ported. V8 rather than a managed
         engine because this runs on ACT's log thread - measured on this parser, V8 takes 68,000
         lines/s where Jint takes 1,600, and a raid pull is a few hundred lines a second with
         bursts. The cost is ~39 MB of native DLLs in the release zip. -->
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1.1" />
  </ItemGroup>
</Project>
