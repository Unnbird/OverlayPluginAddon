<Project>
    <!-- Version of the addon. build.ps1 and the build workflow read AssemblyVersion from
         here to name the archive and the CI artifact.
         MSBuild imports only the nearest Directory.Build.props, so the OverlayPlugin
         projects we reference keep using their own copy. -->
    <PropertyGroup>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <FileVersion>0.1.0</FileVersion>
        <Version>0.1.0</Version>
    </PropertyGroup>
</Project>
